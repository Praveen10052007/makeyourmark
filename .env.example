# GEMINI_API_KEY: Required for Google Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional AI Providers (Server-side only - leave unset if unused)
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional External Data APIs (Server-side only)
# YOUTUBE_API_KEY="AIza..."
# LIVE_JOBS_API_KEY=""

# AUTH_SESSION_SECRET: Secret used to sign server-side session cookies for local email auth.
AUTH_SESSION_SECRET="change-me-in-production"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
